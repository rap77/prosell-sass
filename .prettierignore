# Generated lockfiles — managed by pnpm, never format by hand
pnpm-lock.yaml

# Playwright generated artifacts
tests/e2e/playwright-report/
tests/e2e/test-results/

# Build outputs
**/.next/
**/dist/
**/coverage/

# AI-DLC audit logs (runtime data, regenerated on each workflow run).
# Already in .gitignore; listed here too because Prettier reads the working
# tree directly and would otherwise flag these files in pre-push checks.
aidlc/spaces/*/intents/*/audit/

# Vendored anti-slop Oxlint plugin — the target repository owns its rules,
# but formatting is upstream's call, not ours; reformatting here would
# diverge from the pristine snapshot the next update diffs against.
apps/web/tools/oxlint/anti-slop/
